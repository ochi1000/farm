{
  "name": "x-android-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed Android device relay, viewing, and browser workflow proof of concept",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-xrunner.ps1",
    "android:install": "adb install -r android-x-runner/app/build/outputs/apk/debug/app-debug.apk",
    "android:start": "adb shell am start -n com.ocorp.xrunner/.MainActivity",
    "android:forward": "adb forward tcp:8765 tcp:8765",
    "android:health": "powershell -Command \"Invoke-RestMethod -Uri http://127.0.0.1:8765/health | ConvertTo-Json\"",
    "android:chrome-open": "powershell -Command \"Invoke-RestMethod -Uri 'http://127.0.0.1:8765/chrome/open' | ConvertTo-Json -Depth 5\"",
    "android:home": "powershell -Command \"Invoke-RestMethod -Uri http://127.0.0.1:8765/home | ConvertTo-Json -Depth 5\"",
    "android:adb-probe": "powershell -Command \"Invoke-RestMethod -Uri http://127.0.0.1:8765/adb-probe | ConvertTo-Json -Depth 5\"",
    "android:relay-status": "powershell -Command \"Invoke-RestMethod -Uri http://127.0.0.1:8765/relay/status | ConvertTo-Json -Depth 5\"",
    "relay:server": "node scripts/relay-server.mjs",
    "relay:adb-connect": "adb connect 127.0.0.1:15555",
    "relay:pki": "powershell -ExecutionPolicy Bypass -File scripts/new-relay-pki.ps1",
    "relay:vps-bundle": "powershell -ExecutionPolicy Bypass -File scripts/build-vps-bundle.ps1",
    "view:remote-device": "powershell -ExecutionPolicy Bypass -File scripts/start-device-view.ps1 -Serial 127.0.0.1:15555",
    "test:screen-off-view": "node scripts/test-screen-off-cdp.mjs",
    "view:background-chrome": "powershell -ExecutionPolicy Bypass -File scripts/start-background-chrome-view.ps1",
    "x:task": "tsx src/x-automation/cli.ts",
    "brain:task": "tsx src/brain/cli.ts",
    "test:brain": "tsx --test src/brain/ollama.test.ts",
    "simulation:status": "node scripts/simulation.mjs status",
    "test:simulation": "node scripts/test-simulation.mjs",
    "test:contextual": "node scripts/test-contextual.mjs",
    "test:contextual:review": "node scripts/test-contextual-review.mjs",
    "eval:contextual:review": "node scripts/eval-contextual-review.mjs",
    "test:contextual:batch": "node scripts/test-contextual-batch.mjs",
    "contextual:batch:smoke": "node scripts/contextual-batch.mjs smoke",
    "contextual:batch:start": "node scripts/contextual-batch.mjs start",
    "contextual:batch:status": "node scripts/contextual-batch.mjs status",
    "contextual:batch:stop": "node scripts/contextual-batch.mjs stop",
    "test:contextual:local": "node scripts/test-contextual.mjs --live --detach",
    "test:persona": "node --test scripts/test-simulation-persona.mjs",
    "test:simulation:ui": "node scripts/test-simulation-ui.mjs",
    "test:simulation:batch": "node scripts/test-simulation.mjs --detach",
    "x:test:intermittent": "tsx src/x-automation/intermittent.ts",
    "x:report": "node scripts/x-run-report.mjs",
    "test:x": "tsx --test src/browser/x-page.test.ts src/browser/x-mutations.test.ts src/x-automation/policy.test.ts src/x-automation/runner.test.ts",
    "test:desktop": "node scripts/test-fleet-ui.mjs",
    "desktop:bundle": "esbuild ./desktop/video-renderer.js --bundle --format=iife --platform=browser --outfile=./desktop/video-renderer.bundle.js",
    "desktop": "npm run build && npm run desktop:bundle && node scripts/launch-desktop.cjs",
    "preflight": "tsx src/cli.ts preflight",
    "test:baseline": "tsx src/cli.ts baseline",
    "test:background": "tsx src/cli.ts background",
    "test:locked": "tsx src/cli.ts locked",
    "test:matrix": "tsx src/cli.ts matrix",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "electron": "^44.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
