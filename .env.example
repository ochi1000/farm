X_START_URL=https://x.com/home
ADB_TIMEOUT_MS=15000
BROWSER_TIMEOUT_MS=20000
CHROME_SCREEN_OFF_LAUNCH_DELAY_MS=8000
X_READY_TIMEOUT_MS=45000
VISIBLE_TEXT_LIMIT=1200

# Local-only model brain. Swap the model tag after compatibility testing.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# X workflow policy. Login remains manual in the device's real Chrome profile.
# X_AUTOMATION_APPROVAL_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
# X_ALLOWED_USERS=approved_test_account
X_MAX_FOLLOWS_PER_DAY=3
X_MAX_LIKES_PER_DAY=10
X_MAX_COMMENTS_PER_DAY=3
X_MAX_POSTS_PER_DAY=2

# VPS relay. Keep CONTROLLER_HOST on loopback and reach it through SSH.
SSH_HOST=102.68.84.191
RELAY_HOST=0.0.0.0
RELAY_PORT=8050
STATUS_HOST=0.0.0.0
STATUS_PORT=8051
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=15555
ADMIN_PORT=8052
RELAY_REGISTRY_PATH=/opt/all-in-relay/relay-devices.json
# Set this on a one-device VPS so controller port 15555 selects it explicitly.
# DEVICE_ID=YOUR_DEVICE_UUID
TLS_CERT_PATH=/opt/all-in-relay/pki/server.cert.pem
TLS_KEY_PATH=/opt/all-in-relay/pki/server.key.pem
TLS_CA_PATH=/opt/all-in-relay/pki/ca.cert.pem
# RELAY_DEVICE_TOKENS={"DEVICE_UUID":"UNIQUE_RANDOM_TOKEN"}
SSH_USERNAME=root
